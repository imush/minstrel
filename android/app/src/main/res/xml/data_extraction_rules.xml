<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: cached music is re-fetchable, so it is left out of
     both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="music-cache"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="music-cache"/>
    </device-transfer>
</data-extraction-rules>
