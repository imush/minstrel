<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the app while it starts: the logo's own ground, so
     there is no white flash before the first frame. Android 12 and later
     draw the launcher icon over their own splash instead (see
     values-v31/styles.xml); this is what everything older shows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
</layer-list>
